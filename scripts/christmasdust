#!/usr/bin/env bash
set -Eeuo pipefail
umask 027
ROOT=/opt/christmasdust
CONFIG=/etc/christmasdust
NODE="$ROOT/node/bin/node"
export PATH="$ROOT/node/bin:/usr/sbin:/usr/bin:/sbin:/bin"
if [[ ${1:-} == version ]]; then
  "$NODE" -p 'const fs=require("fs"); const p="/opt/christmasdust/current/"; JSON.parse(fs.readFileSync(p+"package.json")).version+" ("+fs.readFileSync(p+"REVISION","utf8").trim()+")"'
  exit
fi
[[ ${1:-} == update ]] || { echo 'Usage: christmasdust version | sudo christmasdust update [branch-or-tag]'; exit 2; }
[[ $EUID == 0 ]] || { echo 'Updates require root.' >&2; exit 1; }
exec 9>/run/lock/christmasdust-update.lock
flock -n 9 || { echo 'Another update is running.' >&2; exit 1; }
channel=${2:-$(cat "$CONFIG/channel")}
[[ $channel =~ ^[a-zA-Z0-9][a-zA-Z0-9._/-]*$ && $channel != *..* ]] || { echo 'Invalid branch/tag'; exit 1; }
previous=$(readlink -f "$ROOT/current" || true)
stage=$(mktemp -d "$ROOT/releases/staging.XXXXXXXX")
chown christmasdust:christmasdust "$stage"
switched=false
snapshot_backup=$(mktemp -d /var/lib/christmasdust-update.XXXXXXXX)
snapshot_state=unrecorded
config_backup=$(mktemp -d "$CONFIG/.detection-update.XXXXXXXX")
config_candidate=$(mktemp "$CONFIG/.detection-candidate.XXXXXXXX")
config_restore=
config_switched=false
snapshot_restore=
management_candidate=
channel_candidate=
fsync_paths() {
  "$NODE" -e 'const fs=require("node:fs"); for (const path of process.argv.slice(1)) {
    const fd=fs.openSync(path,"r"); try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
  }' "$@"
}
cleanup() {
  rm -rf -- "$stage" "$snapshot_backup" "$config_backup"
  rm -f -- "$config_candidate"
  if [[ -n $config_restore ]]; then rm -f -- "$config_restore"; fi
  if [[ -n $snapshot_restore ]]; then rm -f -- "$snapshot_restore"; fi
  if [[ -n $management_candidate ]]; then rm -f -- "$management_candidate"; fi
  if [[ -n $channel_candidate ]]; then rm -f -- "$channel_candidate"; fi
}
rollback() {
  local result=$?
  trap - ERR INT TERM
  if [[ $switched == true && -n $previous && -d $previous ]]; then
    echo 'Update failed; restoring previous application, configuration and snapshot.' >&2
    systemctl stop christmasdust || true
    if [[ $config_switched == true ]]; then
      # Reverse the commit order: durable legacy config first, old pointer second.
      config_restore=$(mktemp "$CONFIG/.detection-restore.XXXXXXXX")
      cp -p "$config_backup/detection.json" "$config_restore"
      fsync_paths "$config_restore" "$CONFIG"
      mv -Tf "$config_restore" "$CONFIG/detection.json"
      fsync_paths "$CONFIG"
    fi
    if [[ $snapshot_state == present ]]; then
      snapshot_restore=$(mktemp /var/lib/christmasdust/.snapshot-restore.XXXXXXXX)
      cp -p "$snapshot_backup/snapshot.json" "$snapshot_restore"
      fsync_paths "$snapshot_restore" /var/lib/christmasdust
      mv -Tf "$snapshot_restore" /var/lib/christmasdust/snapshot.json
      fsync_paths /var/lib/christmasdust
    elif [[ $snapshot_state == absent ]]; then
      rm -f /var/lib/christmasdust/snapshot.json
      fsync_paths /var/lib/christmasdust
    fi
    # Restore every old-release input before making the old pointer durable.
    [[ ! -e $ROOT/rollback-link || -L $ROOT/rollback-link ]]
    rm -f "$ROOT/rollback-link" # A prior interrupted update may have left it.
    ln -s "$previous" "$ROOT/rollback-link"
    fsync_paths "$ROOT"
    mv -Tf "$ROOT/rollback-link" "$ROOT/current"
    fsync_paths "$ROOT"
    systemctl reset-failed christmasdust || true
    systemctl start christmasdust || true
    if health; then echo 'Previous version is healthy.' >&2; else echo 'Rollback needs attention: journalctl -u christmasdust' >&2; fi
  fi
  exit "${result:-1}"
}
trap cleanup EXIT
trap rollback ERR INT TERM
health() {
  local endpoint expected
  expected=$(cat "$ROOT/current/REVISION")
  endpoint=$("$NODE" --env-file="$CONFIG/christmasdust.env" --input-type=module -e '
    const host=process.env.HOST||"127.0.0.1";
    const target=["0.0.0.0","::"].includes(host)?"127.0.0.1":host;
    console.log("http://"+(target.includes(":")?"["+target+"]":target)+":"+(process.env.PORT||3001)+"/api/ready");')
  for _ in {1..30}; do
    if systemctl is-active --quiet christmasdust &&
      curl --noproxy '*' -fsS --max-time 2 "$endpoint" | "$NODE" --input-type=module -e '
        let body=""; for await (const chunk of process.stdin) body+=chunk;
        try { const data=JSON.parse(body); process.exit(data.ready === true && data.revision === process.argv[1] ? 0 : 1); } catch { process.exit(1); }
      ' "$expected"; then
      if [[ ${1:-} == commit ]]; then switched=false; fi
      return 0
    fi
    sleep 1
  done
  return 1
}
echo "Preparing ChristmasDust channel: $channel"
runuser -u christmasdust -- git clone --quiet --depth 1 --branch "$channel" -- https://github.com/llit47/christmasdust.git "$stage/app"
revision=$(git -c safe.directory="$stage/app" -C "$stage/app" rev-parse HEAD)
printf '%s\n' "$revision" > "$stage/app/REVISION"
# No lifecycle scripts execute during deployment; the app has no build step.
(cd "$stage/app" && runuser -u christmasdust -- npm ci --omit=dev --ignore-scripts --cache "$stage/npm-cache")
(cd "$stage/app" && runuser -u christmasdust -- npm test && runuser -u christmasdust -- npm run check)
# Generate with the unprivileged service user; root copies into a protected
# candidate beside the live file before staged-release validation.
cp -p "$CONFIG/detection.json" "$config_backup/detection.json"
fsync_paths "$config_backup/detection.json" "$config_backup" "$CONFIG"
cp "$config_backup/detection.json" "$stage/detection-source.json"
chown christmasdust:christmasdust "$stage/detection-source.json"
chmod 0600 "$stage/detection-source.json"
migration_state=$(cd "$stage/app" && runuser -u christmasdust -- "$NODE" scripts/migrate-detection.js "$stage/detection-source.json" "$stage/detection-candidate.json")
detection_validation_path="$CONFIG/detection.json"
if [[ $migration_state == migrated ]]; then
  cp "$stage/detection-candidate.json" "$config_candidate"
  chown --reference="$config_backup/detection.json" "$config_candidate"
  chmod --reference="$config_backup/detection.json" "$config_candidate"
  detection_validation_path="$config_candidate"
elif [[ $migration_state != current ]]; then
  echo 'Unexpected detection migration result' >&2; exit 1
fi
(cd "$stage/app" && runuser -u christmasdust -- "$NODE" --env-file="$CONFIG/christmasdust.env" --input-type=module -e '
  import {readConfig,loadDetection} from "./src/config/index.js";
  import {loadGeoip} from "./src/services/geoip.js";
  const c=readConfig(); await loadDetection(process.argv[1]); await loadGeoip(c.geoipPath);' \
  "$detection_validation_path")
release="$ROOT/releases/$(date -u +%Y%m%dT%H%M%S)-${revision:0:12}-${stage##*.}"
[[ ! -e $release ]]
mv "$stage/app" "$release"
chown -R root:root "$release"
chmod -R a+rX,go-w "$release"
# Flush the completed tree, including npm-installed files, before making it
# reachable through current. The releases directory entry is then fsynced.
sync -f "$release"
fsync_paths "$ROOT/releases"
switched=true
systemctl stop christmasdust
if [[ -f /var/lib/christmasdust/snapshot.json ]]; then
  cp -p /var/lib/christmasdust/snapshot.json "$snapshot_backup/snapshot.json"
  fsync_paths "$snapshot_backup/snapshot.json" "$snapshot_backup" /var/lib
  snapshot_state=present
else
  snapshot_state=absent
fi
if [[ $migration_state == migrated ]] && ! cmp -s "$config_backup/detection.json" "$CONFIG/detection.json"; then
  echo 'Detection configuration changed during update; retrying is safe.' >&2
  false
fi
[[ ! -e $ROOT/next-link || -L $ROOT/next-link ]]
rm -f "$ROOT/next-link" # A prior interrupted update may have left it.
ln -s "$release" "$ROOT/next-link"
fsync_paths "$ROOT"
mv -Tf "$ROOT/next-link" "$ROOT/current"
# This directory fsync is the durability barrier: the new release pointer
# must be on disk before a v2-only detection file can be committed.
fsync_paths "$ROOT"
if [[ $migration_state == migrated ]]; then
  config_switched=true
  fsync_paths "$config_candidate" "$CONFIG"
  mv -Tf "$config_candidate" "$CONFIG/detection.json"
  fsync_paths "$CONFIG"
fi
systemctl reset-failed christmasdust || true
systemctl start christmasdust
health commit
# Readiness and revision verification commit the application/config transaction.
# Ancillary failures below must never roll back a healthy candidate.
trap - ERR INT TERM
finalization_failed=false
if management_candidate=$(mktemp /usr/local/bin/.christmasdust.XXXXXXXX) &&
  install -m 0755 "$release/scripts/christmasdust" "$management_candidate" &&
  fsync_paths "$management_candidate" /usr/local/bin &&
  mv -Tf "$management_candidate" /usr/local/bin/christmasdust &&
  fsync_paths /usr/local/bin; then
  :
else
  echo 'Application is healthy, but refreshing the management command failed.' >&2
  finalization_failed=true
fi
if channel_candidate=$(mktemp "$CONFIG/.channel-candidate.XXXXXXXX") &&
  printf '%s\n' "$channel" > "$channel_candidate" &&
  chown --reference="$CONFIG/channel" "$channel_candidate" &&
  chmod --reference="$CONFIG/channel" "$channel_candidate" &&
  fsync_paths "$channel_candidate" "$CONFIG" &&
  mv -Tf "$channel_candidate" "$CONFIG/channel" &&
  fsync_paths "$CONFIG"; then
  :
else
  echo 'Application is healthy, but saving the update channel failed.' >&2
  finalization_failed=true
fi
echo "ChristmasDust updated to $revision. Previous release retained: ${previous:-none}"
[[ $finalization_failed == false ]]
