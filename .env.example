NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DISCOVERY_INTERVAL_MS=600000
LIVE_INTERVAL_MS=45000
QUERY_CONCURRENCY=8
QUERY_TIMEOUT_MS=5000
DISCOVERY_TIMEOUT_MS=15000
DISCOVERY_LIMIT=5000
MAX_SERVERS=1000
STALE_AFTER_MS=180000
RETENTION_MS=604800000
SNAPSHOT_PATH=./data/snapshot.json
RATINGS_PATH=./data/ratings.sqlite
STATS_PATH=./data/player-stats.sqlite
DETECTION_PATH=./config/detection.json
# auto: Web API when keyed plus master UDP. steam requires a key; seeds disables both.
DISCOVERY_MODE=auto
STEAM_API_KEY=
# Optional local MaxMind GeoLite2 City MMDB; native install path is documented in docs/INSTALL.md.
GEOIP_PATH=
# Comma-separated literal IPs/CIDRs, never a hop count or "true".
TRUSTED_PROXIES=
# Only enable when these proxies strip/replace CF-IPCountry and origin access is restricted.
TRUST_CF_COUNTRY=false
# Optional, minimum 32 characters. Empty disables administrative refresh.
ADMIN_TOKEN=
